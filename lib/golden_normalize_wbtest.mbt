    ("1467~1487年", "1467〜1487年"),
    ("巴 マミ", "巴マミ"),
    ("ﾃｨﾛ･ﾌｨﾅｰﾚ", "ティロ・フィナーレ"),
    ("（株）ＡＢＣ\u{3000}ホールディングス", "(株)ABCホールディングス"),
    ("TEL：０３－１２３４－５６７８", "TEL:03ー1234ー5678"),
    ("ｳﾞｧｲｵﾘﾝ", "ヴァイオリン"),
    ("𠮷野家 の カレー", "𠮷野家のカレー"),
    ("line1\nline2", "line1\nline2"),
    ("tab\tsep", "tab\tsep"),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = normalize(input, remove_space=true, tilde=Tilde::NormalizeZenkaku)
    if actual != expected {
      fail("normalize(\{input}) = \{actual}, expected \{expected}")
    }
  }
}


  for pair in cases {
    let (input, expected) = pair
    let actual = normalize(input, remove_space=true, tilde=Tilde::NormalizeZenkaku)
    if actual != expected {
      fail("normalize(\{input}) = \{actual}, expected \{expected}")
    }
  }
}


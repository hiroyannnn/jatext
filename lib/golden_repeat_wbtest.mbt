    ("い", "い"),
    ("😀あ😀aaあa😀ああbい😀", "😀あ😀aaあa😀ああbい😀"),
    ("あいaab", "あいaab"),
    ("いいあい😀", "いいあい😀"),
    ("😀い", "😀い"),
    ("😀bいあaい😀😀", "😀bいあaい😀😀"),
    ("いいあ😀いいbああ", "いいあ😀いいbああ"),
    ("a😀aいいba", "a😀aいいba"),
    ("aaい", "aaい"),
    ("あいあaaいい😀い😀", "あいあaaいい😀い😀"),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = shorten_repeat(input, 2, max_repeat_substr_length=2)
    if actual != expected {
      fail("shorten_repeat(\{input}) = \{actual}, expected \{expected}")
    }
  }
}

///|
test "shorten_repeat threshold=1 max_repeat_substr_length=1" {
  let cases : Array[(String, String)] = [
    ("あ", "あ"),
    ("bあ😀いbbい😀bbab😀", "bあ😀いbい😀bab😀"),
    ("bbba😀いいあいいあa", "ba😀いあいあa"),
    ("aいb😀あb😀a", "aいb😀あb😀a"),
    ("aい😀a😀", "aい😀a😀"),
    ("aあ😀bbaあい😀い", "aあ😀baあい😀い"),
    ("bい😀bあいい", "bい😀bあいい"),
    ("😀いaいあいい", "😀いaいあいい"),
    ("aaいあいあbbabあa", "aいあいあbabあa"),
    ("いい😀いaaいあaab", "い😀いaいあaab"),
    ("ab😀い😀b", "ab😀い😀b"),
    ("あaa", "あaa"),
    ("😀abああbいaaいb", "😀abあbいaいb"),
    ("a😀あbあaa😀あabあい", "a😀あbあa😀あabあい"),
    ("あaああbb", "あaあbb"),
    ("a", "a"),
    ("b😀b", "b😀b"),
    ("😀bb😀b😀ああ", "😀b😀b😀ああ"),
    ("いabaい😀あa", "いabaい😀あa"),
    ("😀bい😀", "😀bい😀"),
    ("ああいあいいいb😀", "あいあいb😀"),
    ("b😀bあa", "b😀bあa"),
    ("abaab😀b😀a", "abab😀b😀a"),
    ("aいい😀", "aいい😀"),
    ("aabbaa😀い😀😀いb", "aba😀い😀いb"),
    ("😀いい😀😀い", "😀い😀😀い"),
    ("いaいaabああい", "いaいabああい"),
    ("abb", "abb"),
    ("あbbbaああ😀いb", "あbaあ😀いb"),
    ("あaいあ", "あaいあ"),
    ("いいあ", "いいあ"),
    ("bい😀bbいあ", "bい😀bいあ"),
    ("ああいいいあ😀😀bい", "あいあ😀bい"),
    ("b😀bbb😀a😀あaあいい", "b😀b😀a😀あaあいい"),
    ("あ😀b😀😀a", "あ😀b😀😀a"),
    ("あa", "あa"),
    ("あいあいあい", "あいあいあい"),
    ("", ""),
    ("baあ😀いああいいあいあ", "baあ😀いあいあいあ"),
    ("a", "a"),
    ("", ""),
    ("あaaああい", "あaああい"),
    ("あ😀bあ😀bあaあbあ", "あ😀bあ😀bあaあbあ"),
    ("😀", "😀"),
    ("😀いaあいaあああい", "😀いaあいaあい"),
    ("b", "b"),
    ("aabいbいbい😀", "abいbいbい😀"),
    ("a😀", "a😀"),
    ("😀あa😀いa😀ba", "😀あa😀いa😀ba"),
    ("bbいbbabb😀", "bいbabb😀"),
    ("", ""),
    ("あいbあbbいいあ", "あいbあbいいあ"),
    ("baい😀😀b", "baい😀😀b"),
    ("", ""),
    ("い😀baあaaaいa😀", "い😀baあaいa😀"),
    ("bba", "bba"),
    ("い😀", "い😀"),
    ("い😀😀あいaaa😀a😀😀b", "い😀あいa😀a😀😀b"),
    ("いbあ😀ああ😀😀あbb", "いbあ😀あ😀あbb"),
    ("😀aあaあ😀い😀bいいbい", "😀aあaあ😀い😀bいbい"),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = shorten_repeat(input, 1, max_repeat_substr_length=1)
    if actual != expected {
      fail("shorten_repeat(\{input}) = \{actual}, expected \{expected}")
    }
  }
}

///|
test "shorten_repeat: fixed #0" {
  assert_eq(shorten_repeat("うまああああああああああああい", 7, max_repeat_substr_length=0), "うまあああああああい")
}

///|
test "shorten_repeat: fixed #1" {
  assert_eq(shorten_repeat("かわいいいいいるい", 6, max_repeat_substr_length=0), "かわいいいいいるい")
}

///|
test "shorten_repeat: fixed #2" {
  assert_eq(shorten_repeat("オラオラオラオラーッ", 2, max_repeat_substr_length=0), "オラオラーッ")
}

///|
test "shorten_repeat: fixed #3" {
  assert_eq(shorten_repeat("隣の客はよく柿食う客だ、隣の客はよく柿食う客だ、隣の客はよく柿食う客だ、言えた！", 1, max_repeat_substr_length=11), "隣の客はよく柿食う客だ、隣の客はよく柿食う客だ、隣の客はよく柿食う客だ、言えた！")
}

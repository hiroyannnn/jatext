    ("ｽｿﾂｷｽｧ", "ｽｿﾂｷｽｧ"),
    ("ｼｽﾟ", "ｼｽﾟ"),
    ("ﾊﾝ", "ﾊﾝ"),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = h2z(input, kana=false, ascii=true, digit=true)
    if actual != expected {
      fail("h2z(\{input}) = \{actual}, expected \{expected}")
    }
  }
}

///|
test "h2z: ignore #0" {
  assert_eq(h2z("ﾃｨﾛﾌｨﾅｰﾚ", ignore="ｨ", kana=true, ascii=false, digit=false), "テｨロフｨナーレ")
}

///|
test "h2z: ignore #1" {
  assert_eq(h2z("ｶﾞ", ignore="ｶ", kana=true, ascii=false, digit=false), "ガ")
}

///|
test "h2z: ignore #2" {
  assert_eq(h2z("abcd", ignore="b", kana=true, ascii=true, digit=false), "ａbｃｄ")
}

///|
test "z2h: ignore #3" {
  assert_eq(z2h("ティロフィナーレ", ignore="ィ", kana=true, ascii=false, digit=false), "ﾃィﾛﾌィﾅｰﾚ")
}

///|
test "z2h: ignore #4" {
  assert_eq(z2h("ＡＢＣＤ１２３４", ignore="Ｂ２", kana=true, ascii=true, digit=true), "AＢCD1２34")
}

    'ホ' => Some('ポ')
    _ => None
  }
}

///|
/// neologdn HIPHENS
fn neologdn_is_hyphen(c : Char) -> Bool {
  match c {
    '˗' | '֊' | '‐' | '‑' | '‒' | '–' | '⁃' | '⁻' | '₋' | '−' => true
    _ => false
  }
}

///|
/// neologdn CHOONPUS
fn neologdn_is_choonpu(c : Char) -> Bool {
  match c {
    '—' | '―' | '─' | '━' | 'ー' | '﹣' | '－' | 'ｰ' => true
    _ => false
  }
}

///|
/// neologdn TILDES
fn neologdn_is_tilde(c : Char) -> Bool {
  match c {
    '~' | '∼' | '∾' | '〜' | '〰' | '～' => true
    _ => false
  }
}

///|
/// neologdn SPACE
fn neologdn_is_space(c : Char) -> Bool {
  match c {
    ' ' | '\u{3000}' => true
    _ => false
  }
}

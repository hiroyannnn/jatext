///|
/// Half-width kana + half-width (han)dakuten composed by jaconv.h2z
fn half_kana_compose(base : Char, mark : Char) -> Char? {
  match (base, mark) {
    ('ｳ', 'ﾞ') => Some('ヴ')
    ('ｶ', 'ﾞ') => Some('ガ')
    ('ｷ', 'ﾞ') => Some('ギ')
    ('ｸ', 'ﾞ') => Some('グ')
    ('ｹ', 'ﾞ') => Some('ゲ')
    ('ｺ', 'ﾞ') => Some('ゴ')
    ('ｻ', 'ﾞ') => Some('ザ')
    ('ｼ', 'ﾞ') => Some('ジ')
    ('ｽ', 'ﾞ') => Some('ズ')
    ('ｾ', 'ﾞ') => Some('ゼ')
    ('ｿ', 'ﾞ') => Some('ゾ')
    ('ﾀ', 'ﾞ') => Some('ダ')
    ('ﾁ', 'ﾞ') => Some('ヂ')
    ('ﾂ', 'ﾞ') => Some('ヅ')
    ('ﾃ', 'ﾞ') => Some('デ')
    ('ﾄ', 'ﾞ') => Some('ド')
    ('ﾊ', 'ﾞ') => Some('バ')
    ('ﾊ', 'ﾟ') => Some('パ')
    ('ﾋ', 'ﾞ') => Some('ビ')
    ('ﾋ', 'ﾟ') => Some('ピ')
    ('ﾌ', 'ﾞ') => Some('ブ')
    ('ﾌ', 'ﾟ') => Some('プ')
    ('ﾍ', 'ﾞ') => Some('ベ')
    ('ﾍ', 'ﾟ') => Some('ペ')
    ('ﾎ', 'ﾞ') => Some('ボ')
    ('ﾎ', 'ﾟ') => Some('ポ')
    _ => None
  }
}


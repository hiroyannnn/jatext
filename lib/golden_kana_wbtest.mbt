    ("ゔぁいおりん", "ヴァイオリン"),
    ("ヴァイオリン", "ヴァイオリン"),
    ("がぎぐげご・ぱぴぷぺぽ", "ガギグゲゴ・パピプペポ"),
    ("ゝゞヽヾ", "ヽヾヽヾ"),
    ("𠮷野家のカレー😀", "𠮷野家ノカレー😀"),
    ("", ""),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = hira2kata(input)
    if actual != expected {
      fail("hira2kata(\{input}) = \{actual}, expected \{expected}")
    }
  }
}

///|
test "kata2hira: sentences" {
  let cases : Array[(String, String)] = [
    ("ともえまみ", "ともえまみ"),
    ("まどか☆マギカ", "まどか☆まぎか"),
    ("巴マミ", "巴まみ"),
    ("キュゥべえ", "きゅぅべえ"),
    ("さくらきょうこ", "さくらきょうこ"),
    ("ゔぁいおりん", "ゔぁいおりん"),
    ("ヴァイオリン", "ゔぁいおりん"),
    ("がぎぐげご・ぱぴぷぺぽ", "がぎぐげご・ぱぴぷぺぽ"),
    ("ゝゞヽヾ", "ゝゞゝゞ"),
    ("𠮷野家のカレー😀", "𠮷野家のかれー😀"),
    ("", ""),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = kata2hira(input)
    if actual != expected {
      fail("kata2hira(\{input}) = \{actual}, expected \{expected}")
    }
  }
}

///|
test "hira2hkata: sentences" {
  let cases : Array[(String, String)] = [
    ("ともえまみ", "ﾄﾓｴﾏﾐ"),
    ("まどか☆マギカ", "ﾏﾄﾞｶ☆マギカ"),
    ("巴マミ", "巴マミ"),
    ("キュゥべえ", "キュゥﾍﾞｴ"),
    ("さくらきょうこ", "ｻｸﾗｷｮｳｺ"),
    ("ゔぁいおりん", "ｳﾞｧｲｵﾘﾝ"),
    ("ヴァイオリン", "ヴァイオリン"),
    ("がぎぐげご・ぱぴぷぺぽ", "ｶﾞｷﾞｸﾞｹﾞｺﾞ･ﾊﾟﾋﾟﾌﾟﾍﾟﾎﾟ"),
    ("ゝゞヽヾ", "ヽヾヽヾ"),
    ("𠮷野家のカレー😀", "𠮷野家ﾉカレｰ😀"),
    ("", ""),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = hira2hkata(input)
    if actual != expected {
      fail("hira2hkata(\{input}) = \{actual}, expected \{expected}")
    }
  }
}

///|
test "enlarge_smallkana: sentences" {
  let cases : Array[(String, String)] = [
    ("ともえまみ", "ともえまみ"),
    ("まどか☆マギカ", "まどか☆マギカ"),
    ("巴マミ", "巴マミ"),
    ("キュゥべえ", "キユウべえ"),
    ("さくらきょうこ", "さくらきようこ"),
    ("ゔぁいおりん", "ゔあいおりん"),
    ("ヴァイオリン", "ヴアイオリン"),
    ("がぎぐげご・ぱぴぷぺぽ", "がぎぐげご・ぱぴぷぺぽ"),
    ("ゝゞヽヾ", "ゝゞヽヾ"),
    ("𠮷野家のカレー😀", "𠮷野家のカレー😀"),
    ("", ""),
  ]
  for pair in cases {
    let (input, expected) = pair
    let actual = enlarge_smallkana(input)
    if actual != expected {
      fail("enlarge_smallkana(\{input}) = \{actual}, expected \{expected}")
    }
  }
}

///|
test "hira2kata: ignore #0" {
  assert_eq(hira2kata("まどまぎ", ignore="ど"), "マどマギ")
}

///|
test "hira2kata: ignore #1" {
  assert_eq(hira2kata("ともえまみ", ignore="とみ"), "とモエマみ")
}

///|
test "hira2hkata: ignore #2" {
  assert_eq(hira2hkata("ともえまみ", ignore="み"), "ﾄﾓｴﾏみ")
}

///|
test "kata2hira: ignore #3" {
  assert_eq(kata2hira("マミサン", ignore="ン"), "まみさン")
}

///|
test "kata2hira: ignore #4" {
  assert_eq(kata2hira("ティロ・フィナーレ", ignore="ー・"), "てぃろ・ふぃなーれ")
}

///|
test "enlarge_smallkana: ignore #5" {
  assert_eq(enlarge_smallkana("キュゥべえ", ignore="ゥ"), "キユゥべえ")
}
